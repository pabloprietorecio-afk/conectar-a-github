; Engine configuration file.
; Football Cards Godot migration baseline
config_version=5

[application]
config/name="Football Cards"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/app_shell.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio_director.gd"
LeagueService="*res://autoload/league_service.gd"
ManagerService="*res://autoload/manager_service.gd"
ProgressionService="*res://autoload/progression_service.gd"
RewardService="*res://autoload/reward_service.gd"
FormationService="*res://autoload/formation_service.gd"
CareerService="*res://autoload/career_service.gd"
SettingsService="*res://autoload/settings_service.gd"
EconomyService="*res://autoload/economy_service.gd"
ChallengeService="*res://autoload/challenge_service.gd"
MarketService="*res://autoload/market_service.gd"
TrainingService="*res://autoload/training_service.gd"
QualityService="*res://autoload/quality_service.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.016, 0.025, 1)
